-- Type-level programming: `keyof`, `T[K]`, conditional types with `infer`,
-- and mapped types — plus the utility types built on them.
--
-- None of `Partial`, `ReturnType`, `Exclude`, ... is known to the analyzer by
-- name. They are ordinary aliases in `luau.d.luaut`, written with the four
-- operators below. Each binding here is annotated with the type it should
-- reduce to, so a wrong reduction shows up as a diagnostic rather than needing
-- to be eyeballed.

type User = {
    id: number,
    name: string,
    nickname?: string,
    readonly created: number,
}

type Handler = (a: number, b: string) -> boolean

-- `keyof` and indexed access -------------------------------------------------
let k1: keyof User = "name"
let k2: User["name"] = "ada"
let k3: User["id" | "name"] = 1

-- Conditional types with `infer` ---------------------------------------------
let r1: ReturnType<Handler> = true
let r2: Parameters<Handler> = [1, "x"]
let r3: ReturnType<() -> string[]> = ["a"]

-- Conditionals over a naked type parameter distribute across a union, which
-- is the whole trick behind `Exclude`.
let x1: Exclude<"a" | "b" | "c", "b"> = "c"
let x2: Extract<string | number | nil, nil> = nil
let x3: NonNullable<string | nil> = "here"

-- Truthiness, spelled out ----------------------------------------------------
-- Only `nil` and `false` are falsy in Luau; `0` and `""` are truthy.
let t1: Falsy = false
let t2: Falsy = nil
let t3: Truthy<string | nil | false> = "kept"

-- Mapped types ---------------------------------------------------------------
let m1: Partial<{ a: number, b: string }> = { a: 1 }
let m2: Required<{ a?: number }> = { a: 1 }
let m3: Readonly<{ x: number }> = { x: 1 }
let m4: Mutable<{ readonly x: number }> = { x: 1 }
let m5: Pick<User, "id" | "name"> = { id: 1, name: "ada" }
let m6: Omit<User, "created" | "nickname"> = { id: 1, name: "ada" }
let m7: Record<string, number> = { anything: 1 }
let m8: Record<"on" | "off", boolean> = { on: true, off: false }

-- A mapped type stays deferred while its input is generic, and reduces when
-- applied. Key remapping (`as`) and a nested indexed access both work.
type Getters<T> = { [K in keyof T as K]: () -> T[K] }
let g1: Getters<{ x: number }> = { x: function() return 1 end }

type Boxed<T> = { [K in keyof T]: T[K][] }
let g2: Boxed<{ x: number, y: string }> = { x: [1], y: ["s"] }

print(k1, k2, k3, r1, r2, r3, x1, x2, x3, t1, t2, t3, m1, m2, m3, m4, m5, m6, m7, m8, g1, g2)
