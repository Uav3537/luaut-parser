-- The Roblox Instance hierarchy, and the three declaration-driven mechanisms
-- that make it useful. None of them is special-cased in the analyzer:
--
--   IsA          <K extends keyof ClassMap>(self, K) -> self is ClassMap[K]
--   GetService   <K extends keyof Services>(self, K) -> Services[K]
--   Instance.new <K extends keyof CreatableClassMap>(K, ...) -> ...[K]
--
-- All three are one generic signature indexing a map of names to types. `K`
-- infers the string *literal* that was passed — its constraint is a union of
-- literals, so it is not widened to `string` — and the indexed access looks
-- the type up. Adding a class means adding one line to the map.
--
-- Every binding here is annotated with what it should infer to, so a wrong
-- result is a diagnostic rather than something to read off the output.
--

-- `IsA` narrows the receiver ------------------------------------------------
const function anchorEverything(model: Instance)
    for _, child in model:GetChildren() do
        if child:IsA("BasePart") then
            -- `child` is a BasePart here, so its properties resolve
            child.Anchored = true
            const size: Vector3 = child.Size
        elseif child:IsA("Humanoid") then
            const health: number = child.Health
            child:TakeDamage(10)
        elseif child:IsA("TextLabel") then
            const text: string = child.Text
        else
            -- nothing was matched, so it is still just an Instance
            const plain: Instance = child
        end
    end
end

-- The overload is chosen by the argument, not by declaration order: a class
-- declared late in the list still narrows to itself.
const function late(x: Instance)
    if x:IsA("BindableEvent") then
        const ev: BindableEvent = x
        ev:Fire(1, 2)
    end
end

-- Structural subtyping gives inheritance --------------------------------------
-- `type Part = BasePart & { ... }`, so a Part is a BasePart is an Instance.
const part: Part = Instance.new("Part")
const asBasePart: BasePart = part
const asInstance: Instance = part

-- Services ------------------------------------------------------------------
-- The service map is intersected into DataModel *and* indexed by GetService,
-- so both spellings give the same type.
const storageByProperty: ReplicatedStorage = game.ReplicatedStorage
const storageByService: ReplicatedStorage = game:GetService("ReplicatedStorage")

const players: Players = game:GetService("Players")
const runService: RunService = game:GetService("RunService")
const collection: CollectionService = game:GetService("CollectionService")

-- A name that is not a service does not type-check as one: `keyof Services`
-- does not contain it, so the lookup yields `unknown` rather than a plausible
-- but wrong `Instance`.
const notAService: unknown = game:GetService("SomeFutureService")

-- Likewise `Instance.new` is restricted to the concrete classes: the map it
-- indexes is `Omit<ClassMap, ...abstract classes>`.
const abstract: unknown = Instance.new("BasePart")

const localPlayer: Player | nil = players.LocalPlayer
const everyone: Player[] = players:GetPlayers()

-- `workspace` is the Workspace service, not a bare Instance.
const camera: Camera | nil = workspace.CurrentCamera
const gravity: number = workspace.Gravity

-- Instance.new --------------------------------------------------------------
const gui: ScreenGui = Instance.new("ScreenGui")
const label: TextLabel = Instance.new("TextLabel", gui)
const notAClass: unknown = Instance.new("NotInTheBaseline")

-- Data types ------------------------------------------------------------------
const position: Vector3 = Vector3.new(1, 2, 3)
const origin: Vector3 = Vector3.zero
const colour: Color3 = Color3.fromRGB(255, 0, 0)
const anchor: UDim2 = UDim2.fromScale(0.5, 0.5)

-- `typeof` still reports Roblox data types by name; every Instance is
-- "Instance".
const function describe(v: Vector3 | Instance | string)
    if typeof(v) == "Vector3" then
        const asVector: Vector3 = v
        return asVector.Magnitude
    elseif typeof(v) == "Instance" then
        const asInst: Instance = v
        return asInst.Name
    end
    const asString: string = v
    return asString
end

print(anchorEverything, late, asBasePart, asInstance, runService, collection,
      storageByProperty, storageByService,
      notAService, abstract, notAClass, localPlayer, everyone, camera, gravity, label,
      position, origin, colour, anchor, describe("x"))
