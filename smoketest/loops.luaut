-- Destructuring in generic-for; numeric-for stays a plain identifier.

const pairsList = [["a", 1], ["b", 2], ["c", 3]]
const records = [
    { id: 1, label: "one" },
    { id: 2, label: "two" },
]

for i, entry in ipairs(pairsList) do
    print(i, entry)
end

-- generalized iteration: each element is yielded directly
for record in records do
    print(record.id, record.label)
end

for i = 1, 10 do
    print(i)
end

for i: number = 10, 1, -1 do
    print(i)
end

for key, { deep } in pairs({ x: { deep: 1 } }) do
    print(key, deep)
end
