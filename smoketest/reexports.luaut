-- Export lists and re-exports. imports.luaut imports every name below, so each
-- one's type is checked there.

-- Everything math.luaut exports.
export * from "./math"

-- Some of util.luaut's names, one of them renamed.
export { helper as help, VERSION } from "./util"

type Size = { w: number, h: number }

const unit: Size = { w: 1, h: 1 }

function area(s: Size): number {
    return s.w * s.h
}

-- Names declared above, a type among them, and one exported twice.
export { unit, area, Size }
export { area as surface }
