-- Narrowing across the ways control leaves a block.
--
-- A branch that cannot fall through narrows the code *after* the `if` — the
-- early-return pattern. What counts as "cannot fall through": `return`,
-- `break`, `continue`, a nested `do` block that does one of those, and an
-- if/else where every branch does.

-- Early return, both directions ---------------------------------------------
function orEmpty(v: string | nil): string {
    if (v == nil) { return "" }
    const present: string = v
    return present
}

function onlyNil(v: string | nil): string {
    if (v ~= nil) { return v }
    const absent: nil = v
    return ""
}

-- A `do` block that returns still exits.
function viaDoBlock(v: string | nil): string {
    if (v == nil) {
        do { return "" }
    }
    const present: string = v
    return present
}

-- Loops ----------------------------------------------------------------------
-- `continue` skips the rest of the iteration, so the code below it is narrowed.
function lengths(items: (string | nil)[]): number {
    let total = 0
    for (_, item in items) {
        if (item == nil) { continue }
        const present: string = item
        total = total + #present
    }
    return total
}

-- `break` leaves the loop, so the code after it in the body is narrowed too.
function firstNil(items: (string | nil)[]): number {
    let seen = 0
    for (_, item in items) {
        if (item == nil) { break }
        const present: string = item
        seen = seen + #present
    }
    return seen
}

-- A `while` is left either because its condition failed or by a `break`, and
-- the state after it is the join of those. `while true` has only the second.
function settle(v: string | nil): string {
    while (true) {
        if (v ~= nil) { break }
        v = "fallback"
    }
    const settled: string = v
    return settled
}

-- `repeat` runs its body at least once, so afterwards the `until` holds.
function untilSet(v: string | nil): string {
    repeat {
        v = "fallback"
    } until ( v ~= nil)
    const settled: string = v
    return settled
}

print(orEmpty(nil), onlyNil(nil), viaDoBlock(nil),
      lengths([]), firstNil([]), settle(nil), untilSet(nil))
